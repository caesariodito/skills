#!/usr/bin/env bash
# Link canonical skills for Claude and native Agent Skills discovery.
# Usage: skills-sync [-n]. Adoption/moves require explicit manual review.
set -euo pipefail
CANON="${SKILLS_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
DRY=0
if [[ "${1:-}" == -n ]]; then DRY=1; shift; fi
[[ $# == 0 ]] || { echo 'Usage: skills-sync [-n]' >&2; exit 2; }
[[ -d "$CANON" ]] || { echo 'Missing canonical skills directory' >&2; exit 1; }
status=0
for dir in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
  if [[ ! -d "$dir" ]]; then
    if [[ "$DRY" == 1 ]]; then printf 'would mkdir: %s\n' "$dir"; else mkdir -p "$dir"; fi
  fi
  for path in "$CANON"/*; do
    [[ -f "$path/SKILL.md" ]] || continue
    target="$dir/$(basename "$path")"
    if [[ -L "$target" && "$(readlink "$target")" == "$path" ]]; then continue; fi
    if [[ -e "$target" || -L "$target" ]]; then
      printf 'conflict: %s; preserve and merge manually\n' "$target" >&2
      status=1
    elif [[ "$DRY" == 1 ]]; then printf 'would link: %s -> %s\n' "$target" "$path"
    else ln -s "$path" "$target"; fi
  done
  for target in "$dir"/*; do
    [[ -L "$target" && ! -e "$target" ]] || continue
    case "$(readlink "$target")" in
      "$CANON"/*)
        if [[ "$DRY" == 1 ]]; then printf 'would prune: %s\n' "$target"; else rm "$target"; fi ;;
    esac
  done
done
exit "$status"
